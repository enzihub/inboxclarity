# Copy to .env.local and fill in. Every value is blank on purpose.
# Supabase project settings > API (https://<project-ref>.supabase.co)
SITE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by the npm supabase:* / generate-types scripts
SUPABASE_PROJECT_REF=

# The FastAPI backend in ../core
NEXT_PUBLIC_CORE_API_URL=
CORE_API_URL=

# Comma-separated emails that see the "send me a brief now" button in Settings
NEXT_PUBLIC_AUTHORIZED_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WELCOME_VIDEO_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
