# Copy to .env and fill in. Every value is blank on purpose.
# Set DEMO_MODE=1 to run without any of the accounts below (invented inbox, stubbed AI, no email sent).
DEMO_MODE=

# Google OAuth (Gmail read-only scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
GEMINI_API_KEY=
OPENAI_KEY=

# Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email delivery (Mailtrap)
MAILTRAP_API_TOKEN=
EMAIL_SUBJECT=
FROM_EMAIL=
FROM_NAME=

# Links inside the email
LOGO_URL=
APP_SETTINGS_URL=

# Optional: Slack slash commands (/news, /health)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Optional: error tracking
SENTRY_DSN=
